# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare_docs"

# JWT (use a long random string, NOT this placeholder)
JWT_SECRET="change-me-to-a-32+char-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-32+char-random-string"
JWT_EXPIRES_IN="24h"
PUBLIC_REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=8
BCRYPT_COST=10

# Production owner bootstrap (used by npm run seed:owner)
OWNER_EMAIL=""
OWNER_TEMP_PASSWORD=""
OWNER_FIRST_NAME=""
OWNER_LAST_NAME=""

# Local document storage (HIPAA: keep outside the repo)
DOCUMENT_STORAGE_DIR="./storage/documents"

# OCR microservice (Phase 3)
OCR_SERVICE_URL="http://localhost:5000"
OCR_TIMEOUT_MS=60000

# LLM for Plan-of-Care drafts (Phase 5).
# Keep provider keys in backend .env only. Never expose them in frontend code.
# LLM_PROVIDER options: auto, gemini, anthropic, openai, none
LLM_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"
ANTHROPIC_VERSION="2023-06-01"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Risk prediction microservice (Phase 6 — owned by Abdul Rehman).
# When unset, the backend uses a heuristic fallback predictor.
ML_SERVICE_URL=""
ML_SERVICE_TIMEOUT_MS=15000

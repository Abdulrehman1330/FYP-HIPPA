generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLINICIAN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum DocumentStatus {
  UPLOADED
  PREPROCESSING
  EXTRACTED
  IN_REVIEW
  APPROVED
  REJECTED
  POC_GENERATED
  RISK_SCORED
  FAILED
}

enum DocumentType {
  OASIS_E2
  POC
  OTHER
}

enum ReviewActionType {
  APPROVE
  EDIT
  REJECT
}

// ============================================================
// TENANTS
// ============================================================

model Clinic {
  id        String       @id @default(uuid())
  name      String
  status    ClinicStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  patients  Patient[]
  documents Document[]
  auditLogs AuditLog[]

  @@map("clinics")
}

// ============================================================
// USERS
// ============================================================

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  firstName          String
  lastName           String
  role               UserRole   @default(CLINICIAN)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Tenancy — null only for SUPER_ADMIN
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  // Reverse relations
  patientProfile      Patient?  @relation("PatientUser")
  patientsAsDoctor    Patient[] @relation("PatientPrimaryDoctor")
  patientsAsClinician Patient[] @relation("PatientPrimaryClinician")

  documents          Document[]
  claimedDocuments   Document[]     @relation("DocumentReviewer")
  reviewActions      ReviewAction[]
  auditLogs          AuditLog[]

  @@index([clinicId])
  @@index([role])
  @@map("users")
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation("PatientUser", fields: [userId], references: [id])

  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])

  mrn          String
  dateOfBirth  DateTime
  enrolledAt   DateTime @default(now())

  primaryDoctorId    String
  primaryDoctor      User    @relation("PatientPrimaryDoctor", fields: [primaryDoctorId], references: [id])

  primaryClinicianId String
  primaryClinician   User    @relation("PatientPrimaryClinician", fields: [primaryClinicianId], references: [id])

  documents     Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, mrn])
  @@index([clinicId])
  @@index([primaryDoctorId])
  @@index([primaryClinicianId])
  @@map("patients")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id                String         @id @default(uuid())
  userId            String         // uploader
  filename          String
  fileType          DocumentType   @default(OTHER)
  status            DocumentStatus @default(UPLOADED)
  storagePath       String
  sizeBytes         Int
  contentType       String
  uploadedAt        DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reviewClaimedById String?
  reviewClaimedAt   DateTime?
  reviewCompletedAt DateTime?

  // Tenancy + patient link — nullable now, NOT NULL after Phase 3
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  user            User             @relation(fields: [userId], references: [id])
  reviewClaimedBy User?            @relation("DocumentReviewer", fields: [reviewClaimedById], references: [id])
  extractedFields ExtractedField[]
  reviewActions   ReviewAction[]
  generatedPocs   GeneratedPoc[]
  riskScore       RiskScore?
  auditLogs       AuditLog[]

  @@index([userId])
  @@index([status])
  @@index([reviewClaimedById])
  @@index([clinicId])
  @@index([patientId])
  @@map("documents")
}

model ExtractedField {
  id            String   @id @default(uuid())
  documentId    String
  fieldName     String
  fieldValue    String?
  confidence    Float    @default(0)
  sourceSnippet String?
  extractedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extracted_fields")
}

model ReviewAction {
  id         String           @id @default(uuid())
  documentId String
  reviewerId String
  action     ReviewActionType
  fieldEdits Json?
  comments   String?
  timestamp  DateTime         @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id])

  @@index([documentId])
  @@map("review_actions")
}

model GeneratedPoc {
  id              String    @id @default(uuid())
  documentId      String
  version         Int       @default(1)
  parentVersionId String?
  sections        Json
  status          String    @default("draft")
  generatedById   String?
  generatedAt     DateTime  @default(now())
  approvedById    String?
  approvedAt      DateTime?

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentVersion GeneratedPoc?  @relation("PocLineage", fields: [parentVersionId], references: [id])
  childVersions GeneratedPoc[] @relation("PocLineage")

  @@unique([documentId, version])
  @@index([documentId])
  @@map("generated_pocs")
}

model RiskScore {
  id          String   @id @default(uuid())
  documentId  String   @unique
  riskScore   Float
  riskClass   String
  explanation Json
  predictedAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("risk_scores")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  userId     String?
  documentId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  // Nullable — null only for SUPER_ADMIN events
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  user     User?     @relation(fields: [userId], references: [id])
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([timestamp])
  @@index([clinicId])
  @@index([action])
  @@map("audit_logs")
}

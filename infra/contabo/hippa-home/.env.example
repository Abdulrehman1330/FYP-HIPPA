# Runtime file for /opt/hippa-home/.env on the VPS.
# Values are written by GitHub Actions from repository secrets.

FRONTEND_IMAGE=ghcr.io/owner/repo/frontend:sha
BACKEND_IMAGE=ghcr.io/owner/repo/backend:sha
OCR_IMAGE=ghcr.io/owner/repo/ocr-service:sha
ML_IMAGE=ghcr.io/owner/repo/ml-service:sha

POSTGRES_DB=hippa_home_prod
POSTGRES_USER=hippa_home_app
POSTGRES_PASSWORD=replace-with-github-secret
DATABASE_URL=postgresql://hippa_home_app:replace-with-url-encoded-password@postgres:5432/hippa_home_prod

JWT_SECRET=replace-with-32-plus-random-chars
JWT_REFRESH_SECRET=replace-with-different-32-plus-random-chars
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d
PUBLIC_REGISTRATION_ENABLED=false
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12

OWNER_EMAIL=owner@example.com
OWNER_TEMP_PASSWORD=replace-with-temporary-password
OWNER_FIRST_NAME=Owner
OWNER_LAST_NAME=Admin

CADDY_ACME_EMAIL=owner@example.com

LLM_PROVIDER=none
HIPPA_HOME_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HIPPA_HOME_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HIPPA_HOME_ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_VERSION=2023-06-01
